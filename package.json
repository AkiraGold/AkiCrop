{
	"name": "akicrop",
	"private": true,
	"version": "0.2.0",
	"type": "module",
	"packageManager": "bun@1.4.4",
	"scripts": {
		"dev": "vite dev",
		"dev:https": "cross-env VITE_HTTPS=true vite dev",
		"dev:host": "vite dev --host",
		"dev:https:host": "cross-env VITE_HTTPS=true vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"generate-icons": "node scripts/generate-icons.cjs",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^22.12.0",
		"@vitejs/plugin-basic-ssl": "^2.3.0",
		"cross-env": "^10.1.0",
		"pngjs": "^7.0.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.5"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
